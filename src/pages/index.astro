---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import HomePhoto from '../assets/blog-placeholder-about.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import TopicChips from '../components/TopicChips.astro';
import {
	AUTHOR_NAME,
	INSTAGRAM_URL,
	MOTTO_ENGLISH,
	MOTTO_SANSKRIT,
	PODCAST_URL,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../consts';

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-photo">
					<Image src={HomePhoto} alt={AUTHOR_NAME} width={480} height={480} />
				</div>
				<div class="hero-intro">
					<h1>{AUTHOR_NAME}</h1>
					<p class="intro-text">{SITE_DESCRIPTION}</p>
					<div class="hero-links">
						<a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Instagram</a>
						<a href={PODCAST_URL} target="_blank" rel="noopener noreferrer">Podcast</a>
					</div>
				</div>
			</section>

			<blockquote class="motto">
				<p class="motto-sanskrit">{MOTTO_SANSKRIT}</p>
				<p class="motto-english">{MOTTO_ENGLISH}</p>
			</blockquote>

			<section class="latest-writing">
				<div class="section-heading">
					<h2>Latest writing</h2>
					<a href="/blog" class="view-all">View all →</a>
				</div>
				<TopicChips />
				<PostList posts={latestPosts} />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 3em;
		margin-bottom: 2.5em;
	}
	.hero-photo {
		flex: 0 0 auto;
		width: 240px;
	}
	.hero-photo :global(img) {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 50%;
	}
	.hero-intro {
		flex: 1 1 auto;
	}
	.hero-intro h1 {
		margin-bottom: 0.25em;
	}
	.intro-text {
		font-size: 1.25em;
		color: rgb(var(--gray-dark));
	}
	.hero-links {
		display: flex;
		gap: 1em;
	}
	.motto {
		margin: 0 0 3em 0;
		padding: 0 0 0 20px;
		border-left: 4px solid var(--accent);
	}
	.motto-sanskrit {
		font-family: 'Noto Sans Devanagari', 'Devanagari Sangam MN', 'Mangal', serif;
		font-size: 1.6em;
		margin-bottom: 0.25em;
	}
	.motto-english {
		font-style: italic;
		color: rgb(var(--gray));
		margin-bottom: 0;
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1em;
	}
	.section-heading h2 {
		margin-bottom: 0;
	}
	.view-all {
		font-size: 0.9em;
		white-space: nowrap;
	}
	@media (max-width: 720px) {
		.hero {
			flex-direction: column;
			text-align: center;
			gap: 1.5em;
		}
		.hero-photo {
			width: 160px;
		}
		.hero-links {
			justify-content: center;
		}
	}
</style>
