---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/BlogPost.astro';
import { AUTHOR_NAME } from '../consts';

const aboutEntry = await getEntry('about', 'about');
const { Content } = await render(aboutEntry);
---

<Layout
	title={`${AUTHOR_NAME}`}
	description={aboutEntry.data.description}
	pubDate={aboutEntry.data.pubDate}
	heroImage={aboutEntry.data.heroImage}
>
	<Content />
</Layout>

