---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getVideoPlatform, getYouTubeId } from '../utils/videos';

const videos = (await getCollection('videos')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const items = videos.map((video) => {
	const platform = getVideoPlatform(video.data.embedUrl);
	const youTubeId = platform === 'youtube' ? getYouTubeId(video.data.embedUrl) : null;
	return { video, platform, youTubeId };
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Videos | ${SITE_TITLE}`} description="Reels and short videos." />
		<style>
			main {
				width: 960px;
			}
			.video-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.video-grid li {
				text-align: center;
			}
			.caption {
				margin-top: 0.5em;
				color: rgb(var(--gray));
			}
			.yt-thumb {
				position: relative;
				display: block;
				width: 100%;
				aspect-ratio: 16 / 9;
				padding: 0;
				border: none;
				cursor: pointer;
				overflow: hidden;
				border-radius: 8px;
			}
			.yt-thumb img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				margin: 0;
				border-radius: 0;
			}
			.yt-thumb .play-icon {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.yt-thumb .play-icon svg {
				width: 3.5rem;
				height: 3.5rem;
				padding: 0.75rem;
				color: rgb(var(--gray-light));
				background: rgba(var(--black), 55%);
				border-radius: 50%;
				transition:
					transform 0.15s ease,
					background 0.15s ease;
			}
			.yt-thumb:hover .play-icon svg,
			.yt-thumb:focus-visible .play-icon svg {
				transform: scale(1.08);
				background: var(--accent);
			}
			.yt-embed {
				width: 100%;
				aspect-ratio: 16 / 9;
				border: none;
				border-radius: 8px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Videos</h1>
			<ul class="video-grid">
				{
					items.map(({ video, platform, youTubeId }) => (
						<li>
							{platform === 'youtube' && youTubeId ? (
								<button
									type="button"
									class="yt-thumb"
									data-yt-id={youTubeId}
									aria-label={`Play video: ${video.data.title}`}
								>
									<img
										src={`https://i.ytimg.com/vi/${youTubeId}/hqdefault.jpg`}
										alt=""
										loading="lazy"
									/>
									<span class="play-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="currentColor">
											<path d="M8 5v14l11-7z" />
										</svg>
									</span>
								</button>
							) : platform === 'instagram' ? (
								<blockquote
									class="instagram-media"
									data-instgrm-permalink={video.data.embedUrl}
									data-instgrm-version="14"
								/>
							) : (
								<a href={video.data.embedUrl} target="_blank" rel="noopener noreferrer">
									{video.data.title}
								</a>
							)}
							<p class="caption">{video.data.caption}</p>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<script async src="//www.instagram.com/embed.js"></script>
		<script>
			document.querySelectorAll('.yt-thumb').forEach((button) => {
				button.addEventListener('click', () => {
					const id = button.getAttribute('data-yt-id');
					const label = button.getAttribute('aria-label') ?? 'YouTube video player';
					if (!id) return;
					const iframe = document.createElement('iframe');
					iframe.className = 'yt-embed';
					iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
					iframe.title = label;
					iframe.allow =
						'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
					iframe.allowFullscreen = true;
					iframe.loading = 'lazy';
					button.replaceWith(iframe);
				});
			});
		</script>
	</body>
</html>
